# ============================================================================
#  custom.config  -  tus configs del kernel (Nodexys)
# ============================================================================
#  Todo lo que pongas aquí se aplica SOBRE el gki_defconfig original, al final
#  de todo (después de SUSFS, NoMount, BPF, etc.), así que tiene la última
#  palabra. Si algo choca con una opción activada por el workflow, gana este
#  archivo.
#
#  Formato (una config por línea):
#     CONFIG_FOO=y               activar
#     CONFIG_FOO=m               como módulo
#     CONFIG_FOO=n               desactivar
#     # CONFIG_FOO is not set    desactivar (formato clásico de kernel)
#     CONFIG_FOO=4096            número
#     CONFIG_FOO="texto"         cadena
#  Las líneas que empiezan con # (y no son "is not set") son comentarios.
#
#  Al terminar la compilación, el workflow revisa el .config final y te avisa
#  (en el resumen del run) si alguna config no quedó como la pediste, por
#  ejemplo porque le falta una dependencia.
#
#  También puedes pasar configs sueltas desde el botón "Run workflow", en el
#  campo "extra_configs", sin editar este archivo.
# ============================================================================

# Ejemplos (quita el # para usarlos):
# CONFIG_LOCALVERSION_AUTO=n
# CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# CONFIG_SCHED_DEBUG=n
# CONFIG_DEBUG_FS=n
