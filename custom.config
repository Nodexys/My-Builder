# ============================================================================
#  custom.config  -  tus configs del kernel (Nodexys)
# ============================================================================
#  Todo lo que pongas aquí se aplica SOBRE el gki_defconfig original, al final
#  de todo (después de SUSFS, NoMount, BPF, etc.), así que tiene la última
#  palabra. Si algo choca con una opción activada por el workflow, gana este
#  archivo.
#
#  Formato (una config por línea):
#     CONFIG_FOO=y               activar
#     CONFIG_FOO=m               como módulo
#     CONFIG_FOO=n               desactivar
#     # CONFIG_FOO is not set    desactivar (formato clásico de kernel)
#     CONFIG_FOO=4096            número
#     CONFIG_FOO="texto"         cadena
#  Las líneas que empiezan con # (y no son "is not set") son comentarios.
#
#  Al terminar la compilación, el workflow revisa el .config final y te avisa
#  (en el resumen del run) si alguna config no quedó como la pediste, por
#  ejemplo porque le falta una dependencia.
#
#  También puedes pasar configs sueltas desde el botón "Run workflow", en el
#  campo "extra_configs", sin editar este archivo.
# ============================================================================

# Ejemplos (quita el # para usarlos):
# CONFIG_LOCALVERSION_AUTO=n
# CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
# CONFIG_SCHED_DEBUG=n
# CONFIG_DEBUG_FS=n
# CONFIG_KFENCE is not set
# CONFIG_UBSAN is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_DEBUG_MEMORY_INIT is not set
# CONFIG_HIST_TRIGGERS is not set
# CONFIG_FUNCTION_ERROR_INJECTION is not set
# CONFIG_CMA_DEBUGFS is not set
# CONFIG_WQ_WATCHDOG is not set
# CONFIG_PCIE_KIRIN is not set
# CONFIG_PCIE_QCOM is not set
# CONFIG_SCSI_UFS_HISI is not set
# CONFIG_POWER_RESET_HISI is not set
# CONFIG_SERIAL_SPRD is not set
# CONFIG_SERIAL_SAMSUNG is not set
# CONFIG_CAN is not set
# CONFIG_IEEE802154 is not set
# CONFIG_TIPC is not set
# CONFIG_PROFILING is not set
# CONFIG_SCHEDSTATS is not set
# CONFIG_DYNAMIC_DEBUG_CORE is not set
# CONFIG_PRINTK_TIME is not set
# CONFIG_PRINTK_CALLER is not set
# CONFIG_TRACE_MMIO_ACCESS is not set
# CONFIG_CMA_SYSFS is not set
# CONFIG_THERMAL_EMULATION is not set
# CONFIG_DETECT_HUNG_TASK is not set
# CONFIG_MAGIC_SYSRQ is not set
